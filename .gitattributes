# Generated files are compared byte for byte against what their generator produces
# (just seed-generate plus an empty git diff). Their line endings cannot depend on the
# system doing the checkout, or regenerating would mark the whole file as modified on
# Windows.
apps/banking-api/seeds/*.sql text eol=lf

# Shell scripts run inside Linux containers, mounted straight from the checkout. With
# core.autocrlf on Windows they arrived with CRLF and the Postgres init step died on its
# first line (`set: illegal option -`), so compose could not start from a Windows tree.
*.sh text eol=lf
