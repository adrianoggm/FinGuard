htmlcov/

# Node
node_modules/
.next/
dist/
build/
.nx/
*.tsbuildinfo

# Entorno y secretos
.env
.env.local
.env.*.local

# Playwright's MCP output: page snapshots and console logs from driving the web client. They are a
# record of one session, not of the repository.
.playwright-mcp/
playwright-report/
test-results/

# Nota local sobre la evolución del orquestador. Es material de lectura personal, no del repositorio.
docs/evolucion-orchestrator.md

# Herramientas y SO
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.claude/*
# Except the project's own skills: finguard-real-conversation is how a change to the conversation
# is validated, so it belongs to the repository and not to one agent's local setup.
!.claude/skills/

# LaTeX build products. The source of the memoir is versioned; what latexmk derives from it is not,
# and the PDF least of all — a binary that changes on every compile makes every diff of the text
# unreadable. Rebuild with `latexmk -pdf docs/memoria-finguard.tex`.
docs/*.aux
docs/*.fdb_latexmk
docs/*.fls
docs/*.log
docs/*.out
docs/*.toc
docs/*.pdf
