# Copia este archivo a .env y ajusta lo que necesites.
# Todos los valores tienen un default en compose.yaml, así que .env es opcional en desarrollo.

# Postgres (superusuario del contenedor, solo administración local)
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard
POSTGRES_DB=finguard
# Puerto en el host. 5442 para no chocar con otros Postgres locales.
POSTGRES_PORT=5442
