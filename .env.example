# Copy this file to .env and adjust whatever you need.
# Every value has a default in compose.yaml, so .env is optional in development.

# Postgres (container superuser, local administration only)
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard
POSTGRES_DB=finguard
# Host port. 5442 so it does not clash with other local Postgres instances.
POSTGRES_PORT=5442
