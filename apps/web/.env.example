# Copy to .env.local, which is gitignored.
#
# The orchestrator's own address and a development token from its table. Both loopback: rule 13
# keeps development credentials on 127.0.0.1, and this page holds one in memory.
VITE_ORCHESTRATOR_URL=http://127.0.0.1:8000
# The token that can also pay. `demo-token-laura-0001` answers questions and refuses payments,
# which is the other half worth seeing.
VITE_ORCHESTRATOR_TOKEN=demo-token-laura-pays
# Voice is opt-in and points to the local gateway; leave empty to disable the control.
VITE_VOICE_GATEWAY_URL=http://127.0.0.1:8090
