# Operational configuration of the orchestrator. Versioned, and deliberately free of
# secrets: `.env` is gitignored and loaded after this file, so anything private — a token
# table, a real credential — belongs there and overrides whatever is here.
#
# These values used to be Final constants inside the adapters, which made them parameters
# and not configuration: changing a timeout meant a commit. This file is where they live
# now, together with the reason each one is what it is, because a default with no reason
# beside it is the next thing somebody changes.
#
# Everything here is measured rather than preferred. The experiments are written up in
# evaluation/planning/RESULTS.md.

# --- the ledger ---------------------------------------------------------------------
# Localhost by default: development credentials never leave 127.0.0.1 (rule 13), and this
# service is useless without banking anyway. compose overrides it with the service name.
ORCHESTRATOR_BANKING_BASE_URL=http://127.0.0.1:8001
ORCHESTRATOR_BANKING_TIMEOUT_SECONDS=10

# Movements returned as evidence beside a figure. Enough to show the answer is real, few
# enough that a chat reply does not become a bank statement. They are a sample and not a
# reconciliation: the total may come from two thousand movements.
ORCHESTRATOR_SUPPORTING_MOVEMENTS=10

# --- local inference ---------------------------------------------------------------
# Where the runtime listens. Configurable because inside a container 127.0.0.1 is the
# container: compose points this at host.docker.internal to reach the daemon on the
# machine, which is where the GPU is.
ORCHESTRATOR_OLLAMA_BASE_URL=http://127.0.0.1:11434

# How long the model stays resident after a request. A cold load measured ~6.9s against
# ~0.1s once resident, which is the difference between a demo that looks broken and one
# that does not.
ORCHESTRATOR_OLLAMA_KEEP_ALIVE=30m

# A ceiling for "something is wrong", not a latency target. A model that does not fit the
# GPU needs this raised or it cannot be measured at all — mistral-nemo:12b exceeded it on
# the first prompt of all three datasets.
ORCHESTRATOR_OLLAMA_TIMEOUT_SECONDS=120

# The context window, and the setting that cost the most to find. Ollama loads a model at
# its *default* window, which for a current model is 256K tokens: the weights of a 4B are
# 3.4GB and at 256K the KV cache takes it to 13GB, so two thirds of the model ran on the
# processor and it measured slower than a 7B. Our prompt is ~1k tokens.
#
# Raising this is not free. The cache grows with it, and a model that no longer fits is
# **silently** split with the CPU rather than refused. Measured: P50 5.28s -> 2.58s.
ORCHESTRATOR_OLLAMA_CONTEXT_TOKENS=4096

# Sampling seed. Ollama picks a random one unless told, and temperature 0 does not make up
# for it: the same prompt against the same model twice moved a score by three points, which
# is enough to invent an improvement that is not there. Pinning it does not make a GPU
# bit-reproducible — batching and non-associative float reduction still move one case in
# seventy-nine — but it removes the one source of noise that was ours to remove.
ORCHESTRATOR_OLLAMA_SEED=0

# Ordinary Ollama models use false. gpt-oss requires a reasoning level when structured
# output is requested; select low locally for that model rather than changing the adapter.
ORCHESTRATOR_OLLAMA_THINK=false

# --- hosted inference (xAI / Grok), off unless a key is set --------------------------
# The key is NOT here. This file is versioned; a credential in it is a credential in the
# repository's history forever. It goes in `.env` beside this one, which is gitignored:
#
#     ORCHESTRATOR_GROQ_API_KEY=xai-...
#
# One place, whichever way the service starts: pydantic loads `.env` after this file, and
# compose reads the same path through an optional `env_file`. The Dockerfile deliberately
# does not COPY it — a secret baked into an image is a secret in every registry that image
# reaches.
#
# With no key the provider is not built at all, so nothing below has any effect and the
# service behaves exactly as it did before this existed. An empty value counts as no key,
# because a provider with a blank credential 401s every request and reports it as a model
# outage.
#
# Both settings have defaults in code and are repeated here to be discoverable. Uncomment
# to change them.
# ORCHESTRATOR_GROQ_BASE_URL=https://api.groq.com/openai/v1
# ORCHESTRATOR_GROQ_TIMEOUT_SECONDS=60

# --- hosted inference (Cloudflare Workers AI), off unless both halves are set ---------
# The same protocol as Groq and therefore the same adapter, pointed at a different base URL.
# See infrastructure/llm/cloudflare_workers_ai.py for why there is no second adapter, and for
# the three things nobody has been able to check without a token — the first of which is
# whether a JSON Schema constrains the decoder here at all, which this pipeline depends on.
#
# **Two values, and neither is here.** The token is a credential. The account id is not, but it
# names whose account gets billed for every question asked, so it is nobody's business in a
# versioned file either. Both go in `.env` beside the Groq key:
#
#     ORCHESTRATOR_CLOUDFLARE_API_TOKEN=...
#     ORCHESTRATOR_CLOUDFLARE_ACCOUNT_ID=...
#
# With either one missing the provider is not built at all. That is stricter than the Groq rule
# on purpose: a token with no account id would post to `/accounts//ai/v1`, which is a 404 that
# reads like an outage rather than like the configuration mistake it is.
#
# The token needs Workers AI permissions. Readiness reads the model catalogue and inference
# runs a model, which are separate permissions — a token that can do one and not the other
# looks like a provider that is down.
#
# All three below have defaults in code and are repeated here to be discoverable.
# ORCHESTRATOR_CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# ORCHESTRATOR_CLOUDFLARE_TIMEOUT_SECONDS=60
# ORCHESTRATOR_CLOUDFLARE_REASONING_HEADROOM=4096

# Which provider plans a query and reads a turn: `ollama`, `groq` or `cloudflare`, and only
# the ones this build was configured for — an unset key is a provider that does not exist, and
# naming it here stops the service rather than failing every question later. The catalogue in
# config/llm.toml chooses who *answers* /v1/messages, which is a different decision — one
# knob per decision, so a change to either can be measured on its own.
#
# Pointing this at a hosted provider also points ORCHESTRATOR_PLANNER_MODEL at that provider's
# names, so the two move together: `openai/gpt-oss-120b` or `@cf/qwen/qwen3-30b-a3b-fp8`
# rather than `qwen2.5-coder:7b`.
ORCHESTRATOR_PLANNER_PROVIDER=ollama

# --- the planner -------------------------------------------------------------------
# Eleven models were measured; this one is fourth on accuracy and it is here because the
# reason to prefer the others stopped being a model property. The capability guard now
# refuses unsupported questions deterministically whichever model is configured, so what
# remains is 6.4 points of accuracy against the only property that is not a noisy
# percentage: 4.7GB fits an 8GB card whole and 6.6GB does not.
ORCHESTRATOR_PLANNER_MODEL=qwen2.5-coder:7b

# Zero on purpose. The planner is not being creative, and a plan that varies between
# identical questions cannot be measured.
ORCHESTRATOR_PLANNER_TEMPERATURE=0.0

# The plan is ~120 tokens. This is headroom, not a target.
ORCHESTRATOR_PLANNER_MAX_OUTPUT_TOKENS=384

# --- gates -------------------------------------------------------------------------
# Deterministic rules to switch off, by name. A JSON list, because the field is a tuple and
# pydantic-settings parses complex types as JSON — an empty string is not valid JSON and
# fails at startup rather than meaning "none", which is worth knowing before you edit this.
#
# Empty means every rule is on, the only sane default: a guard that is off by accident reads
# like a control while enforcing nothing. A name this build does not have stops the service.
#
# `uv run python scripts/evaluate_planning.py --ablate` says what each one is worth.
ORCHESTRATOR_DISABLED_GUARDS=[]

# The financial endpoints, off unless a deployment turns them on. Two known risks produce a
# confident wrong figure rather than an error, and documenting a risk is not controlling
# it. See docs/next.md for what has to be true before this becomes a default.
ORCHESTRATOR_QUESTIONS_ENABLED=false

# The payment endpoints, off unless a deployment turns them on, and separately from the
# questions: a deployment that answers questions has not thereby agreed to move money.
# Turning this on exposes a surface where a sentence somebody typed ends in a bank transfer,
# behind a preview and an explicit confirmation. See docs/next.md, gate 2.
ORCHESTRATOR_PAYMENTS_ENABLED=false

# The home screen's window and how many movements it lists. Product decisions about what a bank
# app shows when it opens, not facts about the ledger — 30 days because that is the period somebody
# recognises as "lately", and 8 movements because that is what fits on a phone before scrolling.
ORCHESTRATOR_SUMMARY_DAYS=30
ORCHESTRATOR_SUMMARY_MOVEMENTS=8

# The browser origins allowed to call this service. An allow-list of exact origins and never
# `*`: the credential travels in an Authorization header, and `*` plus credentials is the
# configuration that lets any page a user visits spend their session.
#
# All four are loopback, which is rule 13 — a development credential does not leave 127.0.0.1.
# 3000 is the port the web client is declared on (vision.md §14); 5173 is Vite's own default, so
# `npm run dev` works before anybody sets one.
ORCHESTRATOR_WEB_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:5173","http://localhost:5173"]

# How loud the service is, and in which shape. JSON because these records are read by grepping for
# a conversation that went wrong, and "planned AGGREGATE in 812ms" is not something you can filter
# on. Set ORCHESTRATOR_LOG_JSON=false for lines a person reads in a terminal.
#
# What goes *into* a record is not configurable: the question text, a Bizum's concept, a contact's
# name and a movement's description never reach a log at any level. See observability.py.
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_LOG_JSON=true

# --- not here ----------------------------------------------------------------------
# ORCHESTRATOR_DEV_TOKENS has no value in this file on purpose. A service that ships with a
# built-in credential ships with a credential everyone knows; put it in `.env`, which is
# gitignored, or supply it from a secret store.

# --- who reads a turn ----------------------------------------------------------------
# `router` is the deterministic rules alone, which is what has always run. `shadow` asks a
# model too, logs whether it agreed and changes no answer. `model` promotes it: the model
# decides everything except a payment, which the rules keep, and the rules also catch the
# turn if the model is unreachable.
#
# The evidence for `model`, because it is not obvious from the corpus. The 879-turn corpus
# scores the rules 100 % — its labels are their answers, so it can never show them failing.
# Against 96 sentences written by something that had never seen this vocabulary, the rules
# reach 37 and `model` reaches 86: the rules match word sequences, so they know "de dónde
# sacas" and lose "de dónde has sacado" to the catch-all. 86 rather than the 88 the model
# scores on its own, because two of those it read as payments and the rules kept them --
# both asked how bizum works rather than instructing anybody to send money.
#
# And then the other side was measured, and `model` is not ready. Replaying all 133
# episodes through it costs 35 failures over 900 turns, two of which move money: "déjalo"
# is read as manners so the transfer it cancels stays open and the next "500" lands inside
# it, and "¿qué traspaso al fondo?" comes back as a transfer -- the rules refuse to let a
# model start a payment and say nothing about a transfer between the holder's own accounts.
# The short balance vocabulary regresses too. The rules lose to phrasing and the model
# loses to context; neither reader dominates on today's numbers.
#
# Left at `router` for that, and because how production reads a turn is an operator's
# decision rather than a default. `model` also puts a model call on every turn.
ORCHESTRATOR_TURN_INTERPRETER=router

# --- who draws a chart -----------------------------------------------------------------
# The same four-rung ladder `ORCHESTRATOR_TURN_INTERPRETER` climbs. `shadow` runs the model
# beside the deterministic floor and shows the floor -- which is how the baseline comparison
# gets collected before anything is risked. Promotion is a measured decision (docs/next.md),
# not a default: this stays `deterministic` until three runs of `just evaluate-visual` say
# otherwise, the same way `router` stayed the reader above until the corpus and the drift
# set were both in.
ORCHESTRATOR_VISUAL_PLANNER=deterministic
# Spent before the floor answers, so it is added latency on every turn the model runs. A
# guess until measured (Wave 3 hardening, M-4, 2026-09-11), not a measurement -- and the
# measurement this repeats config.py's own note about is right-censored by construction: a
# run made at this budget can never report a P95 above it, so "measuring" the budget from
# such a run would only ratify the guess. Generous here so shadow measures the model rather
# than the budget.
ORCHESTRATOR_VISUAL_PLANNER_BUDGET_SECONDS=6.0
# The visual planner's own provider, model and sampling. Blank means "the financial planner's",
# which is what shipped. Set them to try a bigger chart model without moving the financial
# planner, whose model was chosen against its own evaluation (evaluation/planning/RESULTS.md).
# The provider must be one of the configured ones, and the model one of that provider's names.
ORCHESTRATOR_VISUAL_PLANNER_PROVIDER=
ORCHESTRATOR_VISUAL_PLANNER_MODEL=
ORCHESTRATOR_VISUAL_PLANNER_TEMPERATURE=
ORCHESTRATOR_VISUAL_PLANNER_MAX_OUTPUT_TOKENS=
